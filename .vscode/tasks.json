{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HSR PlayTools: Build",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/build.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
